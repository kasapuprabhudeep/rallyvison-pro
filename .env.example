# RallyVision AI Environment Configuration

PROJECT_NAME=RallyVision AI
VERSION=1.0.0
API_V1_STR=/api
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-tokens-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (Default Out-of-the-Box Zero-Setup)
DATABASE_URL=sqlite:///./rallyvision.db

# Managed PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/rallyvision_db

# Storage & Uploads
MAX_UPLOAD_SIZE_MB=250

# BWF Court Constants
COURT_LENGTH_M=13.40
COURT_WIDTH_SINGLES_M=5.18
COURT_WIDTH_DOUBLES_M=6.10

